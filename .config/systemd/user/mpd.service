[Unit]
Description=Music Player Daemon
Documentation=man:mpd(1) man:mpd.conf(5)
After=network.target sound.target pulseaudio.service pipewire-pulse.service

[Service]
Type=simple
# mpd.conf is generated by mpdc (mpd-configurer.sh), not hand-edited or
# stowed directly -- see workspace/scripts/mpd-configurer.sh and
# skills/dotfiles-management/references/music-sync-and-mpd.md. Skip
# cleanly (ConditionPathExists failure, not a crash) instead of
# Restart=on-failure looping if the unit is ever enabled before
# `mpdc configure` has run once.
ConditionPathExists=%h/.config/mpd/mpd.conf
# --no-daemon: mpd double-forks on its own by default, which under
# Type=forking races systemd's PID guess the same way eww.service did
# (see personal-systemd-services.md §7) -- run in the foreground instead
# so systemd tracks the real process directly.
ExecStart=/usr/bin/mpd --no-daemon %h/.config/mpd/mpd.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target personal-services.target
