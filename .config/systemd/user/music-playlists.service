[Unit]
Description=Music Playlists Sync - pull m3u playlists from gdrive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/music-sync/playlists.env
ExecStart=/usr/local/bin/rclone-sync.sh ${MUSIC_SYNC_PROFILE}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=music-playlists-sync

[Install]
WantedBy=default.target personal-services.target
