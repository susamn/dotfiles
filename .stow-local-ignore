# .stow-local-ignore
# NOTE: This file REPLACES stow's built-in ignore list entirely.
# Always replicate the important built-in defaults below.

# --- stow built-in defaults (must be kept here since this file overrides them) ---
CVS
\.cvsignore
\.svn
\.git
\.gitignore
\.gitmodules
_darcs
\.hg
\.bzr
\.bzrignore
RCS
\.stow-local-ignore
\.stow

# --- aistuff: agent assets, not stow packages ---
# workspace/aistuff/skills is deployed via do-stow.sh symlinks; workspace/aistuff/mcp is merged into
# each agent's config by agm.sh. Neither belongs in the stow tree.
^aistuff$
^workspace/aistuff$

# --- agent guide ---
# Agent instruction files are GENERATED (not symlinked) outside the repo by
# do-stow.sh from workspace/aistuff/skills/AGENTS-TEMPLATE.md — e.g. ~/.claude/CLAUDE.md.
# Nothing to stow here. This entry is retained in case an AGENTS.md is added at
# the root.
^AGENTS\.md$

# --- stow management scripts ---
# These resolve DOTFILES_DIR from ${BASH_SOURCE[0]}. If stowed as ~/do-stow.sh,
# that resolves to ~/ instead of ~/dotfiles/ and the scripts break.
^do-stow\.sh$
^do-unstow\.sh$
