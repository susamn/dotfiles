#!/usr/bin/env bash

set -euo pipefail

SECURED_DIR="$HOME/.config/_secured"
BACKENDS_DIR="$HOME/.config/rclone-backends"
RCL_CONF_DIR="$HOME/.config/rclone"
RCL_CONF_FILE="$RCL_CONF_DIR/rclone.conf"
PROPERTIES_FILE="$SECURED_DIR/locations.properties"

# rclone remote names may contain letters, digits, _ . + -
SECTION_RE='^\[([A-Za-z0-9_.+-]+)\][[:space:]]*$'

# Ensure GPG TTY is set
export GPG_TTY=$(tty 2>/dev/null || echo "")

log_info() { echo -e "✅ \033[1;32m$1\033[0m"; }
log_warn() { echo -e "⚠️  \033[1;33m$1\033[0m"; }
log_err()  { echo -e "❌ \033[1;31m$1\033[0m"; return 1; }
log_fatal(){ echo -e "❌ \033[1;31m$1\033[0m"; exit 1; }

mkdir -p "$SECURED_DIR" "$BACKENDS_DIR" "$RCL_CONF_DIR"
shopt -s nullglob

create_backup() {
    local file="$1"
    local datestamp
    datestamp=$(date +%Y%m%d_%H%M%S)
    if [[ -f "$file" ]]; then
        cp -p "$file" "${file}.${datestamp}.backup"
        log_info "Backup created: $(basename "${file}").${datestamp}.backup"
    fi
}

# Structural check: confirms the file is a well-formed symmetrically-encrypted
# OpenPGP message. Needs no passphrase, so it costs no extra prompt.
# (gpg --symmetric already confirms the passphrase via repeat-entry.)
gpg_archive_sane() {
    { gpg --list-packets --batch --pinentry-mode cancel < "$1" 2>/dev/null || true; } \
        | grep -q 'symkey enc packet'
}

# --- Inventory -------------------------------------------------------------
# A "remote" is any name seen in the active rclone.conf, in the decrypted
# backends dir, or as an encrypted rclone_<name>.gpg. Union of all three.

REMOTES=()          # remote names, sorted
R_ACTIVE=()         # 1 if a [name] section exists in rclone.conf
R_PLAIN=()          # 1 if rclone-backends/<name>.conf exists
R_GPG=()            # 1 if _secured/rclone_<name>.gpg exists
R_STATE=()          # NEW | LOCKED | SYNCED | MODIFIED | ORPHAN

active_sections() {
    [[ -f "$RCL_CONF_FILE" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ $SECTION_RE ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
        fi
    done < "$RCL_CONF_FILE"
}

scan_remotes() {
    REMOTES=(); R_ACTIVE=(); R_PLAIN=(); R_GPG=(); R_STATE=()

    local names=()
    local n
    while IFS= read -r n; do
        [[ -n "$n" ]] && names+=("$n")
    done < <(active_sections)
    for f in "$BACKENDS_DIR"/*.conf;      do n=$(basename "$f"); names+=("${n%.conf}"); done
    for f in "$SECURED_DIR"/rclone_*.gpg; do n=$(basename "$f"); n="${n#rclone_}"; names+=("${n%.gpg}"); done

    [[ ${#names[@]} -eq 0 ]] && return 0

    local sorted=()
    while IFS= read -r n; do
        [[ -n "$n" ]] && sorted+=("$n")
    done < <(printf '%s\n' "${names[@]}" | sort -u)

    local active_list=""
    active_list=$(active_sections || true)

    for n in "${sorted[@]}"; do
        local a=0 p=0 g=0
        printf '%s\n' "$active_list" | grep -qxF -- "$n" && a=1
        if [[ -f "$BACKENDS_DIR/$n.conf" ]]; then
            p=1
            # plaintext remote config must never be group/world readable
            [[ "$(stat -c '%a' "$BACKENDS_DIR/$n.conf")" == "600" ]] || chmod 600 "$BACKENDS_DIR/$n.conf"
        fi
        [[ -f "$SECURED_DIR/rclone_$n.gpg" ]] && g=1

        local state
        if   (( g == 0 ));            then state="NEW"
        elif (( p == 0 && a == 0 ));  then state="LOCKED"
        elif (( p == 0 && a == 1 ));  then state="ORPHAN"
        elif (( a == 0 ));            then state="UNLINKED"
        elif [[ "$BACKENDS_DIR/$n.conf" -nt "$SECURED_DIR/rclone_$n.gpg" ]]; then state="MODIFIED"
        else                               state="SYNCED"
        fi

        REMOTES+=("$n"); R_ACTIVE+=("$a"); R_PLAIN+=("$p"); R_GPG+=("$g"); R_STATE+=("$state")
    done
}

state_text() {
    case "$1" in
        NEW)      echo "NEW" ;;
        LOCKED)   echo "Locked" ;;
        MODIFIED) echo "Modified" ;;
        ORPHAN)   echo "Orphan" ;;
        UNLINKED) echo "Unlinked" ;;
        *)        echo "Synced" ;;
    esac
}

state_hue() {
    case "$1" in
        NEW)      echo "1;35" ;;
        LOCKED)   echo "1;33" ;;
        MODIFIED) echo "1;31" ;;
        ORPHAN)   echo "1;31" ;;
        UNLINKED) echo "1;36" ;;
        *)        echo "1;32" ;;
    esac
}

# Colourised, width-correct cell: pad the plain text first, then wrap in colour.
cell() { printf '\033[%sm%-*s\033[0m' "$2" "$3" "$1"; }

flag_text() { (( $1 )) && echo "yes" || echo "--"; }
flag_hue()  { (( $1 )) && echo "1;32" || echo "1;30"; }

show_status() {
    scan_remotes
    echo ""
    echo -e "\033[1;36m════════════════════════════════════════════════════════════════════════════\033[0m"
    echo -e " ⚡ \033[1;37mRCLONE PROFILE MANAGER\033[0m   \033[1;30m($RCL_CONF_FILE)\033[0m"
    echo -e "\033[1;36m────────────────────────────────────────────────────────────────────────────\033[0m"
    printf " \033[1;37m%-4s %-22s %-8s %-10s %-8s %s\033[0m\n" "ID" "REMOTE" "GPG" "PLAINTEXT" "ACTIVE" "STATE"
    echo -e "\033[1;36m────────────────────────────────────────────────────────────────────────────\033[0m"

    if [[ ${#REMOTES[@]} -eq 0 ]]; then
        echo "   No remotes found (no rclone.conf, no backends, no rclone_*.gpg)."
    else
        local i st
        for i in "${!REMOTES[@]}"; do
            st="${R_STATE[i]}"
            printf " \033[1;32m%-4d\033[0m %-22s %s %s %s %s\n" \
                "$((i+1))" "${REMOTES[i]}" \
                "$(cell "$(flag_text "${R_GPG[i]}")"    "$(flag_hue "${R_GPG[i]}")"    8)" \
                "$(cell "$(flag_text "${R_PLAIN[i]}")"  "$(flag_hue "${R_PLAIN[i]}")"  10)" \
                "$(cell "$(flag_text "${R_ACTIVE[i]}")" "$(flag_hue "${R_ACTIVE[i]}")" 8)" \
                "$(cell "$(state_text "$st")" "$(state_hue "$st")" 10)"
        done
    fi
    echo -e "\033[1;36m════════════════════════════════════════════════════════════════════════════\033[0m"
    echo -e " \033[1;30mNEW = never encrypted · MODIFIED = plaintext newer than .gpg · UNLINKED = decrypted but not in rclone.conf · ORPHAN = in rclone.conf but no backend file\033[0m"
}

# --- Selection -------------------------------------------------------------
SELECTED=()

# prompt_selection "<verb>" [state-filter ...]
# Populates SELECTED with remote indices. Returns 1 on cancel/empty.
prompt_selection() {
    local verb="$1"; shift
    local -a allowed=("$@")
    SELECTED=()

    if [[ ${#REMOTES[@]} -eq 0 ]]; then
        log_warn "No remotes to $verb."
        return 1
    fi

    local -a eligible=()
    local i
    for i in "${!REMOTES[@]}"; do
        if [[ ${#allowed[@]} -eq 0 ]]; then
            eligible+=("$i")
        else
            local s
            for s in "${allowed[@]}"; do
                [[ "${R_STATE[i]}" == "$s" ]] && { eligible+=("$i"); break; }
            done
        fi
    done

    if [[ ${#eligible[@]} -eq 0 ]]; then
        log_warn "No remotes are eligible to $verb."
        return 1
    fi

    echo ""
    echo -e "\033[1;34m--- Select remote(s) to $verb ---\033[0m"
    local pos=1
    local -a map=()
    for i in "${eligible[@]}"; do
        printf " \033[1;32m%-3d\033[0m %-22s %s\n" "$pos" "${REMOTES[i]}" \
            "$(cell "$(state_text "${R_STATE[i]}")" "$(state_hue "${R_STATE[i]}")" 10)"
        map+=("$i")
        pos=$((pos+1))
    done
    echo -e " \033[1;30mEnter ids (1,3), ranges (1-3), 'all', or 'q' to cancel\033[0m"
    echo -n "Choice: "
    local input
    read -r input
    input="${input// /}"
    [[ -z "$input" || "$input" == "q" ]] && { echo "Cancelled."; return 1; }

    local -a picked=()
    if [[ "$input" == "all" ]]; then
        picked=("${map[@]}")
    else
        local tok
        local oldifs="$IFS"; IFS=','
        local -a toks=($input)
        IFS="$oldifs"
        for tok in "${toks[@]}"; do
            local lo hi
            if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                lo="${BASH_REMATCH[1]}"; hi="${BASH_REMATCH[2]}"
            elif [[ "$tok" =~ ^[0-9]+$ ]]; then
                lo="$tok"; hi="$tok"
            else
                log_warn "Invalid selection token: '$tok'"; return 1
            fi
            local k
            for (( k=lo; k<=hi; k++ )); do
                if (( k < 1 || k > ${#map[@]} )); then
                    log_warn "Out of range: $k"; return 1
                fi
                picked+=("${map[k-1]}")
            done
        done
    fi

    # dedupe, preserve order
    local idx seen
    for idx in "${picked[@]}"; do
        seen=0
        for s in ${SELECTED[@]+"${SELECTED[@]}"}; do
            [[ "$s" == "$idx" ]] && { seen=1; break; }
        done
        (( seen == 0 )) && SELECTED+=("$idx")
    done

    [[ ${#SELECTED[@]} -eq 0 ]] && { echo "Nothing selected."; return 1; }
    return 0
}

# --- Section extraction ----------------------------------------------------

# Write only the [name] section of rclone.conf into $2. Returns 1 if absent.
extract_section() {
    local name="$1" out="$2"
    local in_sec=0 found=0
    [[ -f "$RCL_CONF_FILE" ]] || return 1
    : > "$out"
    chmod 600 "$out"
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ $SECTION_RE ]]; then
            if [[ "${BASH_REMATCH[1]}" == "$name" ]]; then
                in_sec=1; found=1
            else
                in_sec=0
            fi
        fi
        if (( in_sec )); then
            printf '%s\n' "$line" >> "$out"
        fi
    done < "$RCL_CONF_FILE"
    [[ $found -eq 1 ]]
}

# Any remote that lives only in rclone.conf would be erased by a rebuild.
# Preserve it as a backend file first (still unencrypted -- the user is told).
preserve_orphans() {
    [[ -f "$RCL_CONF_FILE" ]] || return 0
    local n saved=()
    while IFS= read -r n; do
        [[ -n "$n" ]] || continue
        if [[ ! -f "$BACKENDS_DIR/$n.conf" ]]; then
            extract_section "$n" "$BACKENDS_DIR/$n.conf" && saved+=("$n")
        fi
    done < <(active_sections)
    if [[ ${#saved[@]} -gt 0 ]]; then
        log_warn "Preserved remote(s) that existed only in rclone.conf: ${saved[*]}"
        log_warn "They are NOT encrypted yet -- run Encrypt on them."
    fi
}

# Rebuild rclone.conf from every decrypted backend file.
assemble_active() {
    preserve_orphans
    local tmp
    tmp=$(mktemp "$BACKENDS_DIR/.assemble.XXXXXX")
    chmod 600 "$tmp"
    local any=0
    local conf
    for conf in "$BACKENDS_DIR"/*.conf; do
        # strip trailing blank lines, then re-add exactly one spacer
        sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba' "$conf" >> "$tmp"
        printf '\n' >> "$tmp"
        any=1
    done
    if (( any == 0 )); then
        rm -f "$tmp"
        [[ -f "$RCL_CONF_FILE" ]] && { create_backup "$RCL_CONF_FILE"; rm -f "$RCL_CONF_FILE"; }
        log_warn "No decrypted backends left. Active rclone.conf removed."
        return 0
    fi
    cat "$tmp" > "$RCL_CONF_FILE"
    rm -f "$tmp"
    chmod 600 "$RCL_CONF_FILE"
    log_info "Rebuilt active config: $RCL_CONF_FILE"
}

# --- locations.properties (shared with generate-secure-resources.sh) -------

properties_has_key() {
    local key="$1"
    [[ -f "$PROPERTIES_FILE" ]] || return 1
    local line k
    while IFS= read -r line || [[ -n "$line" ]]; do
        k="${line%%=*}"
        k="${k#"${k%%[![:space:]]*}"}"
        k="${k%"${k##*[![:space:]]}"}"
        [[ "$k" == "$key" ]] && return 0
    done < "$PROPERTIES_FILE"
    return 1
}

register_mapping() {
    local name="$1"
    local key="rclone_${name}.gpg"
    local val="~/.config/rclone-backends/${name}.conf"
    if properties_has_key "$key"; then
        return 0
    fi
    # append without breaking a symlinked properties file
    printf '%s=%s\n' "$key" "$val" >> "$PROPERTIES_FILE"
    chmod 644 "$PROPERTIES_FILE"
    log_info "Registered in locations.properties: $key -> $val"
}

unregister_mapping() {
    local key="$1"
    [[ -f "$PROPERTIES_FILE" ]] || return 0
    local tmp
    tmp=$(mktemp)
    local line k
    while IFS= read -r line || [[ -n "$line" ]]; do
        k="${line%%=*}"
        k="${k#"${k%%[![:space:]]*}"}"
        k="${k%"${k##*[![:space:]]}"}"
        [[ "$k" == "$key" ]] && continue
        printf '%s\n' "$line" >> "$tmp"
    done < "$PROPERTIES_FILE"
    cat "$tmp" > "$PROPERTIES_FILE"
    rm -f "$tmp"
    chmod 644 "$PROPERTIES_FILE"
    log_info "Removed mapping: $key"
}

# --- Actions ---------------------------------------------------------------

encrypt_one() {
    local i="$1"
    local name="${REMOTES[i]}"
    local plain="$BACKENDS_DIR/$name.conf"
    local enc="$SECURED_DIR/rclone_$name.gpg"

    echo ""
    echo -e "\033[1;34m🔐 Encrypting '$name'\033[0m"

    # Always prefer the live rclone.conf section, so an edited remote is
    # captured verbatim. Fall back to an existing backend file.
    if (( ${R_ACTIVE[i]} )); then
        if extract_section "$name" "$plain"; then
            log_info "Extracted section [$name] from active rclone.conf"
        else
            log_warn "Could not extract [$name] from rclone.conf"; return 1
        fi
    elif [[ ! -f "$plain" ]]; then
        log_warn "'$name' has no plaintext source (not in rclone.conf, no backend file). Decrypt it first."
        return 1
    else
        log_info "Using existing backend file: ${plain/#$HOME/\~}"
    fi
    chmod 600 "$plain"

    local tmp
    tmp=$(mktemp "$SECURED_DIR/.enc.XXXXXX")
    trap 'rm -f "$tmp"' RETURN

    echo "🔐 Enter NEW passphrase for '$name':"
    if ! gpg --symmetric --cipher-algo AES256 --pinentry-mode loopback --yes --output "$tmp" "$plain"; then
        log_warn "Encryption failed for '$name'."; return 1
    fi
    if ! gpg_archive_sane "$tmp"; then
        log_warn "New archive for '$name' is malformed. Original left untouched."; return 1
    fi

    [[ -f "$enc" ]] && create_backup "$enc"
    mv "$tmp" "$enc"
    chmod 600 "$enc"
    trap - RETURN
    log_info "Encrypted -> rclone_${name}.gpg"
    register_mapping "$name"
}

decrypt_one() {
    local i="$1"
    local name="${REMOTES[i]}"
    local plain="$BACKENDS_DIR/$name.conf"
    local enc="$SECURED_DIR/rclone_$name.gpg"

    echo ""
    echo -e "\033[1;34m🔓 Decrypting '$name'\033[0m"
    if [[ ! -f "$enc" ]]; then
        log_warn "No encrypted file for '$name'."; return 1
    fi
    if [[ -f "$plain" ]]; then
        echo -n "Backend file for '$name' already exists. Overwrite? [yes/no]: "
        local c; read -r c
        [[ "$c" != "yes" ]] && { echo "Skipped."; return 0; }
        create_backup "$plain"
    fi

    echo "🔒 Enter passphrase for '$name':"
    if gpg --quiet --yes --pinentry-mode loopback --decrypt --output "$plain" < "$enc"; then
        chmod 600 "$plain"
        log_info "Decrypted -> ${plain/#$HOME/\~}"
        register_mapping "$name"
    else
        rm -f "$plain"
        log_warn "Decryption failed for '$name'."; return 1
    fi
}

verify_one() {
    local i="$1"
    local name="${REMOTES[i]}"
    local enc="$SECURED_DIR/rclone_$name.gpg"
    echo ""
    if [[ ! -f "$enc" ]]; then
        log_warn "'$name' is not encrypted yet."; return 1
    fi
    echo "🔒 Enter passphrase to verify '$name':"
    if gpg --quiet --pinentry-mode loopback --decrypt < "$enc" > /dev/null 2>&1; then
        log_info "Passphrase correct for '$name'."
    else
        log_warn "Passphrase incorrect for '$name'."
    fi
}

change_pass_one() {
    local i="$1"
    local name="${REMOTES[i]}"
    local enc="$SECURED_DIR/rclone_$name.gpg"

    echo ""
    echo -e "\033[1;34m🔑 Changing passphrase for '$name'\033[0m"
    if [[ ! -f "$enc" ]]; then
        log_warn "'$name' is not encrypted yet. Use Encrypt instead."; return 1
    fi

    local tmp_plain tmp_cipher
    tmp_plain=$(mktemp "$BACKENDS_DIR/.rot.XXXXXX")
    tmp_cipher=$(mktemp "$SECURED_DIR/.rot.XXXXXX")
    chmod 600 "$tmp_plain" "$tmp_cipher"
    trap 'rm -f "$tmp_plain" "$tmp_cipher"' RETURN

    echo "🔒 Enter CURRENT passphrase for '$name':"
    if ! gpg --quiet --yes --pinentry-mode loopback --decrypt --output "$tmp_plain" < "$enc"; then
        log_warn "Decryption failed for '$name'. Passphrase may be wrong."; return 1
    fi
    echo ""
    echo "🔐 Enter NEW passphrase for '$name':"
    if ! gpg --symmetric --cipher-algo AES256 --pinentry-mode loopback --yes --output "$tmp_cipher" "$tmp_plain"; then
        log_warn "Re-encryption failed for '$name'."; return 1
    fi
    if ! gpg_archive_sane "$tmp_cipher"; then
        log_warn "Re-encrypted archive for '$name' is malformed. Original left untouched."; return 1
    fi

    create_backup "$enc"
    mv "$tmp_cipher" "$enc"
    chmod 600 "$enc"
    rm -f "$tmp_plain"
    trap - RETURN
    log_info "Passphrase changed for '$name'."
}

lock_one() {
    local i="$1"
    local name="${REMOTES[i]}"
    local plain="$BACKENDS_DIR/$name.conf"
    local enc="$SECURED_DIR/rclone_$name.gpg"

    echo ""
    if [[ ! -f "$enc" ]]; then
        log_warn "Refusing to lock '$name': it has no rclone_${name}.gpg. Encrypt it first."
        return 1
    fi
    if [[ -f "$plain" ]]; then
        rm -f "$plain"
        log_info "Removed plaintext backend for '$name'."
    else
        log_info "'$name' already had no plaintext backend."
    fi
}

sync_active_to_backends() {
    echo ""
    if [[ ! -f "$RCL_CONF_FILE" ]]; then
        log_warn "No active rclone.conf to sync from."; return 1
    fi
    prompt_selection "sync from active rclone.conf" || return 0
    local i n=0
    for i in "${SELECTED[@]}"; do
        local name="${REMOTES[i]}"
        if (( ${R_ACTIVE[i]} == 0 )); then
            log_warn "'$name' is not in the active rclone.conf. Skipped."
            continue
        fi
        if extract_section "$name" "$BACKENDS_DIR/$name.conf"; then
            log_info "Synced [$name] -> ${BACKENDS_DIR/#$HOME/\~}/$name.conf"
            n=$((n+1))
        fi
    done
    log_info "Synced $n remote(s). Encrypt them to persist the change."
}

run_over_selection() {
    local fn="$1"; shift
    prompt_selection "$@" || return 0
    local i ok=0 fail=0
    for i in "${SELECTED[@]}"; do
        if "$fn" "$i"; then ok=$((ok+1)); else fail=$((fail+1)); fi
    done
    echo ""
    log_info "Done: $ok succeeded, $fail skipped/failed."
}

action_encrypt() {
    run_over_selection encrypt_one "encrypt"
}

action_decrypt() {
    run_over_selection decrypt_one "decrypt" LOCKED UNLINKED SYNCED MODIFIED ORPHAN
    echo -n "Rebuild active rclone.conf from all decrypted backends now? [yes/no]: "
    local c; read -r c
    [[ "$c" == "yes" ]] && assemble_active
}

action_lock() {
    run_over_selection lock_one "lock"
    assemble_active
}

action_lock_all() {
    echo ""
    scan_remotes
    local i unsafe=()
    for i in "${!REMOTES[@]}"; do
        (( ${R_GPG[i]} == 0 )) && unsafe+=("${REMOTES[i]}")
    done
    if [[ ${#unsafe[@]} -gt 0 ]]; then
        log_warn "These remotes are NOT encrypted and would be lost: ${unsafe[*]}"
        echo -n "Lock anyway (they will be destroyed)? [yes/no]: "
        local c; read -r c
        [[ "$c" != "yes" ]] && { echo "Aborted."; return 0; }
    fi
    rm -f "$BACKENDS_DIR"/*.conf
    [[ -f "$RCL_CONF_FILE" ]] && rm -f "$RCL_CONF_FILE"
    log_info "Locked everything: backends dir cleared, rclone.conf removed."
}

show_menu() {
    while true; do
        show_status
        echo ""
        echo -e "\033[1;37m 1\033[0m) Encrypt remote(s)            \033[1;30m(picks up NEW + MODIFIED remotes)\033[0m"
        echo -e "\033[1;37m 2\033[0m) Decrypt remote(s)"
        echo -e "\033[1;37m 3\033[0m) Change passphrase for remote(s)"
        echo -e "\033[1;37m 4\033[0m) Verify passphrase for remote(s)"
        echo -e "\033[1;37m 5\033[0m) Sync active rclone.conf -> backend file(s)"
        echo -e "\033[1;37m 6\033[0m) Rebuild active rclone.conf from decrypted backends"
        echo -e "\033[1;37m 7\033[0m) Lock remote(s)                \033[1;30m(drop plaintext, keep .gpg)\033[0m"
        echo -e "\033[1;37m 8\033[0m) Lock everything"
        echo -e "\033[1;37m 9\033[0m) Refresh"
        echo -e "\033[1;37m q\033[0m) Exit"
        echo -n "Select action: "
        local action
        read -r action

        case "$action" in
            1) action_encrypt ;;
            2) action_decrypt ;;
            3) run_over_selection change_pass_one "change passphrase" ;;
            4) run_over_selection verify_one "verify" ;;
            5) sync_active_to_backends ;;
            6) assemble_active ;;
            7) action_lock ;;
            8) action_lock_all ;;
            9) : ;;
            q|Q) exit 0 ;;
            *) log_warn "Invalid option" ;;
        esac
        echo ""
        echo -n "Press Enter to continue..."
        read -r _
    done
}

show_menu
